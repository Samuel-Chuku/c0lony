# Cloudflare Pages response headers. When several rules match a path, Pages merges them, and a header set
# by two rules gets both values joined. So Cache-Control is set only in the path-specific rules below,
# never in the catch-all.

# Security headers for every page. No full Content-Security-Policy: wallets, WalletConnect, Privy, the RPC,
# drand, KyberSwap and the proof host are all cross-origin, and a strict policy would break them.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Hashed build assets never change, so they can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell, service worker and API must always be fresh.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/api/*
  Cache-Control: no-store
