# Copy to web/.env.local (or set in Vercel).

# Canonical site URL (used for metadata, Open Graph and links)
NEXT_PUBLIC_SITE_URL=https://c0lony.xyz

# --- Server-only (never NEXT_PUBLIC_): Quicknode RPC URLs contain the API key.
# The browser talks to the app's own /api/rpc route, which forwards to these.
ROBINHOOD_RPC_URL=https://<your-endpoint>.robinhood-mainnet.quiknode.pro/<key>/
ROBINHOOD_TESTNET_RPC_URL=https://<your-endpoint>.robinhood-testnet.quiknode.pro/<key>/

# --- Public, browser-visible values (no secrets)
# "testnet" (46630) or "mainnet" (4663)
NEXT_PUBLIC_NETWORK=testnet

NEXT_PUBLIC_COLONY_GAME_ADDRESS=
NEXT_PUBLIC_SEASON_POT_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_WIF_ADDRESS=

# WalletConnect project id (free, from cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# drand evmnet
NEXT_PUBLIC_DRAND_API_URL=https://api.drand.sh
NEXT_PUBLIC_DRAND_CHAIN_HASH=04f1e9062b8a81f848fded9c12306733282b2727ecced50032187751166ec8c3

# KyberSwap Aggregator (chain route "robinhood"); fee goes to the Treasury contract
NEXT_PUBLIC_KYBER_API_URL=https://aggregator-api.kyberswap.com/robinhood/api/v1
NEXT_PUBLIC_KYBER_CLIENT_ID=c0lony

# Where the keeper serves Voter's Pass proofs
NEXT_PUBLIC_KEEPER_URL=
