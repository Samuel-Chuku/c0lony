# Build variables for the static site. Copy to web/.env.local for local dev; on Cloudflare Pages set them
# under Settings → Variables and Secrets (Production and Preview).
# Every NEXT_PUBLIC_ value is baked into the static files and readable by anyone: never put a secret here.

# Which of the two static sites to build: "landing" (c0lony.xyz) or "app" (app.c0lony.xyz).
# Each Pages project sets its own value; everything else below is the same for both.
NEXT_PUBLIC_SITE=landing
# Canonical URLs (metadata, Open Graph, and the links between the two sites)
NEXT_PUBLIC_LANDING_URL=https://c0lony.xyz
NEXT_PUBLIC_APP_URL=https://app.c0lony.xyz

# Chain: 46630 = Robinhood Chain testnet, 4663 = mainnet
NEXT_PUBLIC_CHAIN_ID=46630
# Browser RPC. The public endpoint until the /api/rpc Pages Function exists; then set it to /api/rpc.
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Contracts (docs/DEPLOYMENTS.md). The Treasury also receives the 0.5% KyberSwap swap fee.
NEXT_PUBLIC_COLONY_GAME_ADDRESS=
NEXT_PUBLIC_SEASON_POT_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_WIF_ADDRESS=

# Keeper on the VPS: activity feed, and Voter's Pass files at <base>/proofs/<address>.json
NEXT_PUBLIC_KEEPER_URL=https://keeper.c0lony.xyz
NEXT_PUBLIC_PROOFS_BASE_URL=https://keeper.c0lony.xyz/voters

# WalletConnect project id (public by design; from cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# drand evmnet
NEXT_PUBLIC_DRAND_API_URL=https://api.drand.sh
NEXT_PUBLIC_DRAND_CHAIN_HASH=04f1e9062b8a81f848fded9c12306733282b2727ecced50032187751166ec8c3

# KyberSwap Aggregator (chain route "robinhood"); sent as x-client-id and source
NEXT_PUBLIC_KYBER_API_URL=https://aggregator-api.kyberswap.com/robinhood/api/v1
NEXT_PUBLIC_KYBER_CLIENT_ID=c0lony

# --- Not build variables: Pages Functions secrets (encrypted, runtime only), added with the functions.
# ROBINHOOD_RPC_URL / ROBINHOOD_TESTNET_RPC_URL  Quicknode URLs (contain the API key), used by /api/rpc
