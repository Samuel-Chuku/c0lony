{
  "name": "c0lony-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:landing",
    "dev:landing": "NEXT_PUBLIC_SITE=landing NEXT_DIST_DIR=.next-landing NEXT_PUBLIC_APP_URL=http://localhost:3001 NEXT_PUBLIC_LANDING_URL=http://localhost:3000 next dev -p 3000",
    "dev:app": "NEXT_PUBLIC_SITE=app NEXT_DIST_DIR=.next-app NEXT_PUBLIC_APP_URL=http://localhost:3001 NEXT_PUBLIC_LANDING_URL=http://localhost:3000 next dev -p 3001",
    "build": "next build",
    "build:landing": "NEXT_PUBLIC_SITE=landing next build",
    "build:app": "NEXT_PUBLIC_SITE=app next build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
