# Copy to keeper/.env on the VPS and fill in there. Never commit .env.

# ---------------------------------------------------------------- network
# "testnet" (46630) or "mainnet" (4663)
NETWORK=testnet
# Quicknode RPC endpoints (HTTPS URLs from the Quicknode dashboard; they include your key)
ROBINHOOD_RPC_URL=https://<your-endpoint>.robinhood-mainnet.quiknode.pro/<key>/
ROBINHOOD_TESTNET_RPC_URL=https://<your-endpoint>.robinhood-testnet.quiknode.pro/<key>/

# ---------------------------------------------------------------- wallet
# Keeper wallet private key. Holds only a small ETH float (~0.0005 ETH);
# settlement gas is refunded by the Treasury contract.
KEEPER_PRIVATE_KEY=
# Stop settling and alert when the keeper balance falls below this (in ETH)
MIN_BALANCE_ETH=0.0002

# ---------------------------------------------------------------- contracts
COLONY_GAME_ADDRESS=
SEASON_POT_ADDRESS=
TREASURY_ADDRESS=
# Block to start scanning game events from (the ColonyGame deploy block)
START_BLOCK=

# ---------------------------------------------------------------- event intake
# "streams" = Quicknode Streams webhook (primary), "poll" = eth_getLogs every POLL_INTERVAL_MS (fallback)
EVENT_SOURCE=streams
POLL_INTERVAL_MS=15000
# Max blocks per eth_getLogs request (halved automatically if the RPC rejects a range)
GETLOGS_CHUNK_BLOCKS=10000
# Blocks behind head the poller waits before reading (reorg safety)
CONFIRMATIONS=2

# Webhook server for Quicknode Streams
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8787
# Each Stream has its own security token (Quicknode dashboard > Stream > Security token)
STREAMS_GAME_TOKEN=
STREAMS_VOTES_TOKEN=
# Reject deliveries whose x-qn-timestamp is older than this (seconds). Backfills sign at send time.
STREAMS_MAX_AGE_SEC=600

# ---------------------------------------------------------------- Voter's Pass
# Candidate vote wallets live in data/world-is-fair-vote-wallets.json
VOTE_WALLETS_FILE=../data/world-is-fair-vote-wallets.json
# First block to index WIF votes from (event #1 votes start around block 50.9M)
VOTES_START_BLOCK=40000000
# Folder the keeper writes voters.json and proofs/<address>.json into; Caddy serves it at /voters/
VOTERS_PUBLIC_DIR=public/voters
# Public URL of the full list (emitted onchain with each new root)
VOTERS_LIST_URI=https://keeper.c0lony.xyz/voters/voters.json

# drand evmnet
DRAND_API_URL=https://api.drand.sh
DRAND_CHAIN_HASH=04f1e9062b8a81f848fded9c12306733282b2727ecced50032187751166ec8c3

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
