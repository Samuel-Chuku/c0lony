# Copy to contracts/.env and fill in locally. Never commit .env.

# RPC endpoints. Public endpoints work but are rate-limited;
# a free Alchemy key is recommended (https://robinhood-testnet.g.alchemy.com/v2/<KEY>).
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Deployer wallet private key (fresh wallet, never one holding personal funds).
# Becomes owner of ColonyGame, SeasonPot and Treasury.
DEPLOYER_PRIVATE_KEY=

# WIF token. Mainnet address is fixed; on testnet this is the MockWIF address
# printed by the testnet deploy script.
WIF_ADDRESS_MAINNET=0x5173b8eA6923c2d40267890D45C46a3480954773
WIF_ADDRESS_TESTNET=

# Address of the keeper wallet (public address only, not its key).
KEEPER_ADDRESS=
