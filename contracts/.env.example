# Copy to contracts/.env and fill in locally. Never commit .env.

# Quicknode RPC endpoints for Robinhood Chain (used for deploys and verification).
# Copy the HTTPS URLs (they include your key) from the Quicknode dashboard.
ROBINHOOD_RPC_URL=https://<your-endpoint>.robinhood-mainnet.quiknode.pro/<key>/
ROBINHOOD_TESTNET_RPC_URL=https://<your-endpoint>.robinhood-testnet.quiknode.pro/<key>/

# Deployer wallet private key (fresh wallet, never one holding personal funds).
# Becomes owner of ColonyGame, SeasonPot and Treasury.
DEPLOYER_PRIVATE_KEY=

# WIF token. Mainnet address is fixed; on testnet this is the MockWIF address
# printed by the testnet deploy script.
WIF_ADDRESS_MAINNET=0x5173b8eA6923c2d40267890D45C46a3480954773
WIF_ADDRESS_TESTNET=

# Address of the keeper wallet (public address only, not its key).
KEEPER_ADDRESS=

# Optional deploy settings
# WIF kept back in the Treasury when anyone calls sweepToPot (18 decimals)
TREASURY_WIF_RESERVE=0
# ETH (in wei) sent to the Treasury gas pool during deploy, e.g. 2000000000000000 = 0.002 ETH
TREASURY_ETH_WEI=0
# The deploy script refuses to run on mainnet unless this is true
ALLOW_MAINNET=false
